# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Where the app talks to the backend. Use your computer's LAN IP for a phone on the same wifi,
# not localhost: the phone cannot reach your computer's localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_WS_URL=ws://192.168.1.10:8000

# Google Maps. Build-time native config, read by app.config.js, not by the app at runtime.
# Android: Google Cloud console -> Credentials -> create an API key, enable "Maps SDK for Android",
# then restrict it to package com.trickshot.neighbourmobile plus the SHA-1 of the signing key
# (`cd android && ./gradlew signingReport` for the debug SHA-1).
# Without this the Android map renders blank.
GOOGLE_MAPS_ANDROID_KEY=

# Only needed while iOS screens pass PROVIDER_GOOGLE to react-native-maps. Enable "Maps SDK for iOS"
# and restrict it to bundle id com.trickshot.neighbourmobile.
GOOGLE_MAPS_IOS_KEY=

# The SOS shortcode the SMS fallback texts when there is no data. Must be the Africa's Talking
# number whose inbound callback points at POST /api/v2/sms/inbound/ (see docs/DEPLOY.md). Compiled
# into the app, because the moment it is needed is the moment there is no network.
EXPO_PUBLIC_SOS_SHORTCODE=
